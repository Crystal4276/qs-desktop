# Config Sway du bureau (phase 10 : reprise de ~/.config/sway/config, sauvegardé dans ~/.config/sway.bak-<date>).
# Barre, notifications, lanceur, menus, fond d'écran, veille, verrouillage, agent polkit, réseau, Bluetooth et disques : Quickshell
# (scripts/desktop.sh). Écrans de cette machine et réglages propres au matériel : hosts/<hostname>.conf, en fin de fichier.

### Variables
    set $mod Mod4
    set $term gnome-terminal -- bash -c "neofetch; exec bash"
    # Dépôt du bureau, via le lien de la config Quickshell (aucun chemin personnel).
    set $qs ~/.config/quickshell/desktop
    set $ipc ~/.config/quickshell/desktop/scripts/ipc.sh

### Bureau Quickshell
    # Relancé s'il s'arrête ; au démarrage, chaque écran affiche le premier espace de son bloc (1 / 4 / 7).
    exec $qs/scripts/desktop.sh

### Idle configuration
    # Veille des écrans : Quickshell (services/Idle.qml). Ces règles l'empêchent, comme avant.
    for_window [class="steam_app_[0-9]+"] inhibit_idle focus
    for_window [app_id="gamescope"] inhibit_idle focus
    for_window [app_id="firefox"] inhibit_idle fullscreen
    for_window [app_id="firefox" title="Picture-in-Picture"] inhibit_idle focus
    for_window [app_id="chromium"] inhibit_idle fullscreen
    for_window [app_id="chromium" title="Picture in picture"] inhibit_idle focus
    for_window [class="Megabonk.x86_64"] inhibit_idle focus

### Key bindings
    # Apps
    bindsym $mod+Return exec $term
    bindsym $mod+w exec $ipc launcher toggle
    bindsym $mod+a exec chromium
    bindsym $mod+c exec chromium https://claude.ai
    bindsym $mod+x exec geany
    bindsym $mod+e exec nemo

    # Display : HDR des écrans compatibles
    bindsym $mod+d exec $ipc display toggleHdr

    # Connect and disconnect VPN (dernier pays utilisé)
    bindsym $mod+u exec $ipc vpn connect ""
    bindsym $mod+i exec $ipc vpn disconnect

    # Sway session bindings
    bindsym $mod+Ctrl+R reload
    bindsym $mod+Escape exec $ipc settings toggle
    bindsym $mod+Ctrl+W exec $qs/scripts/desktop.sh restart
    bindsym $mod+Ctrl+q exec swaymsg exit

# Moving / resizing windows around:

    # Kill focused window
    bindsym $mod+q kill

    # Make the current focus fullscreen
    bindsym $mod+f fullscreen
    bindsym $mod+g fullscreen toggle global

    # Drag floating windows by holding down $mod and left mouse button.
    # Resize them with right mouse button + $mod.
    floating_modifier $mod normal

    # Move window on the same monitor
    bindsym $mod+Ctrl+Left move left
    bindsym $mod+Ctrl+Down move down
    bindsym $mod+Ctrl+Up move up
    bindsym $mod+Ctrl+Right move right

    # Move window between Monitor
    bindsym $mod+Left move container to output left, focus output left
    bindsym $mod+Right move container to output right, focus output right

    # Application assignments to workspace
    assign [instance="discord"] 5
    # Web app Discord : app_id selon l'adresse de départ (avec ou sans numéro de salon).
    assign [app_id="^chrome-discord\.com__channels_@me(_[0-9]+)?-Default$"] 5
    assign [app_id="whatsdesk"] 5
    assign [app_id="chrome-web.whatsapp.com__-Default"] 5
    assign [class="Spotify"] 6
    assign [app_id="deluge"] 7
    assign [app_id="org.mozilla.Thunderbird"] 8
    assign [title="Steam"] 9

    # Switch to workspace 7 when Deluge's "Add Torrents" dialog appears
    for_window [app_id="deluge" title="Add Torrents.*"] {
    move container to workspace 7
    workspace 7
    }

# Floating rules
    floating_maximum_size -1 x -1
    for_window [app_id="gnome-disks"] floating enable, move position center
    for_window [app_id="blueman-manager"] floating enable, move position center
    for_window [title="Volume Control"] floating enable, move position center
    for_window [app_id="virt-manager"] floating enable, move position center
    for_window [title="Calculator"] floating enable, move position center
    for_window [class="steam" title="Steam Settings"] floating enable, move position center
    for_window [class="steam" title="Special Offers"] floating enable, move position center
    for_window [app_id="nm-connection-editor"] floating enable, move position center

# General Steam games rules
    for_window [class="steam_app_[0-9]+"] move container to workspace number 3
    for_window [app_id="gamescope"] {
        move container to workspace number 3
        fullscreen toggle global
        focus
        }
    for_window [instance="steamwebhelper" class="steam" title="Special Offers"] move container to workspace number 9

# EVE Launcher specific exception and EVE wine tray window exception
    for_window [class="steam_app_8500" title="EVE Launcher"] floating enable, resize set 1600 800, move position center, move container to workspace number 9
    for_window [class="steam_app_8500" title="^$"] floating enable, move position 1280 20, move container to workspace number 9

# Workspaces:
    # Aucune attribution `workspace N output …` : répartition par Quickshell selon les écrans actifs (docs/ARCHITECTURE.md § 3.2).
    # Un espace qui n'existe pas encore est créé sur l'écran de son bloc ; sans Quickshell, commande native.

    # Switch to workspace
    bindsym $mod+1 exec $ipc outputs focus 1 || swaymsg workspace number 1
    bindsym $mod+2 exec $ipc outputs focus 2 || swaymsg workspace number 2
    bindsym $mod+3 exec $ipc outputs focus 3 || swaymsg workspace number 3
    bindsym $mod+4 exec $ipc outputs focus 4 || swaymsg workspace number 4
    bindsym $mod+5 exec $ipc outputs focus 5 || swaymsg workspace number 5
    bindsym $mod+6 exec $ipc outputs focus 6 || swaymsg workspace number 6
    bindsym $mod+7 exec $ipc outputs focus 7 || swaymsg workspace number 7
    bindsym $mod+8 exec $ipc outputs focus 8 || swaymsg workspace number 8
    bindsym $mod+9 exec $ipc outputs focus 9 || swaymsg workspace number 9

    # Move to workspace commands (le focus suit la fenêtre)
    bindsym $mod+Ctrl+1 exec $ipc outputs moveWindow 1 || swaymsg "move container to workspace number 1, workspace number 1"
    bindsym $mod+Ctrl+2 exec $ipc outputs moveWindow 2 || swaymsg "move container to workspace number 2, workspace number 2"
    bindsym $mod+Ctrl+3 exec $ipc outputs moveWindow 3 || swaymsg "move container to workspace number 3, workspace number 3"
    bindsym $mod+Ctrl+4 exec $ipc outputs moveWindow 4 || swaymsg "move container to workspace number 4, workspace number 4"
    bindsym $mod+Ctrl+5 exec $ipc outputs moveWindow 5 || swaymsg "move container to workspace number 5, workspace number 5"
    bindsym $mod+Ctrl+6 exec $ipc outputs moveWindow 6 || swaymsg "move container to workspace number 6, workspace number 6"
    bindsym $mod+Ctrl+7 exec $ipc outputs moveWindow 7 || swaymsg "move container to workspace number 7, workspace number 7"
    bindsym $mod+Ctrl+8 exec $ipc outputs moveWindow 8 || swaymsg "move container to workspace number 8, workspace number 8"
    bindsym $mod+Ctrl+9 exec $ipc outputs moveWindow 9 || swaymsg "move container to workspace number 9, workspace number 9"

# Layout config:

    # Switch the current container between different layout styles
    bindsym $mod+grave split toggle
    bindsym $mod+h splith
    bindsym $mod+v splitv

    # Toggle the current focus between tiling and floating mode
    bindsym --whole-window $mod+button2 floating toggle

    # Toggle window maximize
    bindsym $mod+Tab layout toggle tabbed split

# Utilities:
    # Volume et micro, avec OSD
    bindsym --locked XF86AudioMute exec $ipc audio toggleMute
    bindsym --locked XF86AudioLowerVolume exec $ipc audio volumeDown
    bindsym --locked XF86AudioRaiseVolume exec $ipc audio volumeUp
    bindsym --locked XF86AudioMicMute exec $ipc audio toggleMicMute

    # Lecture (lecteur choisi dans la barre), comme sous Hyprland
    bindsym --locked XF86AudioPlay exec $ipc media playPause
    bindsym --locked XF86AudioPause exec $ipc media playPause
    bindsym --locked XF86AudioNext exec $ipc media next
    bindsym --locked XF86AudioPrev exec $ipc media previous

    # Switch audio output to the next one
    bindsym $mod+s exec $ipc audio cycleSink

    # Brightness (laptop), avec OSD
    bindsym --locked XF86MonBrightnessDown exec $ipc brightness down
    bindsym --locked XF86MonBrightnessUp exec $ipc brightness up

    # Captures : zone, écran, fenêtre (enregistrées dans Images/screenshot et copiées)
    bindsym Print exec $ipc screenshot area
    bindsym $mod+Print exec $ipc screenshot screen
    bindsym $mod+Shift+Print exec $ipc screenshot window

# Windows appearance
    default_border pixel 1
    default_floating_border pixel 1
    smart_borders off
    gaps inner 10
    gaps left 0
    gaps right 0
    gaps top 0
    gaps bottom 0

# Border colors
    client.focused          #6c7086 #6c7086 #ffffff #6c7086   #6c7086
    client.unfocused        #45475a #45475a #ffffff #45475a   #45475a
    client.urgent           #a6e3a1 #a6e3a1 #ffffff #a6e3a1   #a6e3a1

# System settings
    exec_always "gsettings set org.gnome.desktop.interface cursor-size 48"
    seat seat0 xcursor_theme catppuccin-mocha-green-cursors 48
    # Les autres (WAYLAND_DISPLAY, DISPLAY, XDG_CURRENT_DESKTOP, SWAYSOCK) : /etc/sway/config.d/50-systemd-user.conf, inclus en fin
    # de fichier.
    exec systemctl --user import-environment I3SOCK XCURSOR_SIZE XCURSOR_THEME
    # Numlock on
    input * xkb_numlock enabled

# VPN : connexion au démarrage (le compte reste connecté, `nordvpn login` n'est pas à rejouer)
    exec "nordvpn c Netherlands"

# Apps autostart (`pkill` : une instance restée d'une session précédente, Steam surtout, est remplacée)
    exec "pkill deluge-gtk || true; deluge-gtk"
    exec "pkill thunderbird || true; sleep 4 && thunderbird"
    exec "pkill steam || true; sleep 4 && steam"
    exec --no-startup-id gtk-launch WebApp-DiscordWeb2996
    exec --no-startup-id gtk-launch WebApp-Whatsapp8699
    exec "pkill spotify || true; sleep 4 && LD_PRELOAD=/usr/lib/spotify-adblock.so spotify"

# Réglages de cette machine : écrans (par description), matériel. Absent sur une autre machine : ignoré.
include hosts/$(cat /proc/sys/kernel/hostname).conf

# Réglages privés (adresses, identifiants, montages) : hors dépôt, jamais versionnés. Absent : ignoré.
include ~/.config/qs-desktop.local/sway.conf

include /etc/sway/config.d/*
