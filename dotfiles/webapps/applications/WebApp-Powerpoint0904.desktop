[Desktop Entry]
Version=1.0
Name=Powerpoint
Comment=Powerpoint
Exec=@WEBAPPS@/open-file %f -- chromium --app="https://www.office.com/launch/powerpoint" --class=WebApp-Powerpoint0904 --name=WebApp-Powerpoint0904 --user-data-dir=@PROFILES@/Powerpoint0904 --load-extension=@WEBAPPS@/open-links
Terminal=false
X-MultipleArgs=false
