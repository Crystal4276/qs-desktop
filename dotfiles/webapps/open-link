#!/usr/bin/env python3
# Hôte natif (Chromium native messaging) de l'extension open-links : ouvre l'URL reçue dans le profil Chromium principal.
# Lancé par le Chromium de la web app : son environnement est retiré de ce qu'il a ajouté (PULSE_PROP_OVERRIDE, sinon le
# navigateur, s'il démarre ici, serait coupé pendant « ne pas déranger » ; variables CHROME_*).
import json
import os
import struct
import subprocess
import sys

size = sys.stdin.buffer.read(4)
url = json.loads(sys.stdin.buffer.read(struct.unpack("=I", size)[0]))["url"] if len(size) == 4 else ""
ok = url.startswith(("http://", "https://"))
if ok:
    env = {k: v for k, v in os.environ.items() if k != "PULSE_PROP_OVERRIDE" and not k.startswith("CHROME_")}
    # Le lien atterrit dans la dernière fenêtre active du navigateur : Quickshell affiche son espace de travail. Instance de la
    # session, désignée par son PID (scripts/ipc.sh) ; sans instance, le lien s'ouvre quand même.
    repo = os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
    try:
        subprocess.run([os.path.join(repo, "scripts", "ipc.sh"), "compositor", "focusNextWindowOf", "chromium"], env=env, timeout=0.5,
                       stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired):
        pass
    subprocess.Popen(["chromium", "--", url], env=env, start_new_session=True,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
reply = json.dumps({"ok": ok}).encode()
sys.stdout.buffer.write(struct.pack("=I", len(reply)) + reply)
sys.stdout.buffer.flush()
