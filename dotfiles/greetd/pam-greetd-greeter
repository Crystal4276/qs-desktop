#%PAM-1.0
# /etc/pam.d/greetd-greeter — installé par scripts/greeter-setup.sh. Session de l'écran de connexion lui-même (utilisateur
# `greeter`) : sans lui, greetd prend /etc/pam.d/greetd, qui lancerait le trousseau pour `greeter`. Comme /etc/pam.d/sddm-greeter.

auth       required     pam_env.so
auth       required     pam_permit.so
account    required     pam_permit.so
password   required     pam_deny.so
session    required     pam_unix.so
session    optional     pam_systemd.so
