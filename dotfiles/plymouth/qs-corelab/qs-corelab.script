// END GENERATED

// Plymouth « Core Lab » theme (docs/PLYMOUTH.md), work profile. Data above: scripts/plymouth-assets.py.
//
// Phases: intro (2.2 s) → passphrase (after the intro, LUKS) → loop (rotation, 2.4 s cycle; it starts as soon as the
// passphrase is entered, during the key derivation; a refusal brings the field back at once and the rotation stops at the
// end of its turn) → exit (at the end of the current cycle, after `plymouth update --status=qs-corelab-exit`) → crust only.
// Every screen shows the same scene: the script plugin centres each display on one canvas, so there is a single scale.
// One screen: its own. Several: the reference screen, 1440 px high (or the one whose height is closest to 1440).
// Plymouth script: no clock function, no hexadecimal or exponent literals, no include. Time comes from the boot progress
// callback (real seconds, 30 updates a second; plymouthd pauses it while a passphrase is typed): the animation follows it
// (catching up when the CPU is busy, e.g. during the key derivation), extrapolated between updates with the measured frame
// period, and runs on that period alone while the clock is paused. Durations hold at any refresh rate (≈ 40/s in VM).
// Measuring statuses (VM bench, docs/DEVELOPMENT.md): bench-intro | bench-peak | bench-loop | bench-idle.

REFRESH = 60;                            // refreshes per second asked (60 Hz panels); the VM display keeps ≈ 41
CYCLE_MS = 2400;                         // rotation cycle
EXIT_STATUS = "qs-corelab-exit";

// crust
Window.SetBackgroundTopColor(17 / 255, 17 / 255, 27 / 255);
Window.SetBackgroundBottomColor(17 / 255, 17 / 255, 27 / 255);

fun ease(lut, p) {
  if (p <= 0) return 0;
  if (p >= 1) return 1;
  local.x = p * EASE_STEPS;
  local.i = Math.Int(x);
  return lut[i] + (lut[i + 1] - lut[i]) * (x - i);
}

fun round(v) {
  if (v < 0) return -Math.Int(-v + 0.5);
  return Math.Int(v + 0.5);
}

// --- Scene ----------------------------------------------------------------------------------------------------------

fun load(name) {
  local.img = Image(S.dir + name);
  if (f < 0.999 || f > 1.001)
    img = img.Scale(round(img.GetWidth() * f), round(img.GetHeight() * f));
  return img;
}

// Sprites of the previous scene are freed by replacing them (a sprite disappears with its last reference).
fun clear_scene() {
  for (local.k = 0; k < ARCS; k++) global.arc[k].sprite = 0;
  for (local.i = 0; i < 4; i++) global.half[i].sprite = 0;
  for (local.k = 0; k < 22; k++) global.dot[k].sprite = 0;
  global.band.sprite = 0;
  global.filet.sprite = 0;
  global.lockup.sprite = 0;
  global.form.prompt.sprite = 0;
  global.form.field.sprite = 0;
  global.form.placeholder.sprite = 0;
  global.form.message.sprite = 0;
  global.ARCS = 0;
}

fun build_scene() {
  clear_scene();
  global.CW = Window.GetWidth();          // canvas: largest display; every display is centred on it
  global.CH = Window.GetHeight();
  local.refh = 0;
  for (local.i = 0; Window.GetWidth(i); i++)
    if (refh == 0 || Math.Abs(Window.GetHeight(i) - 1440) < Math.Abs(refh - 1440)) refh = Window.GetHeight(i);
  if (refh <= 0) { global.SCENE = 0; return; }
  global.s = refh / 1200;

  // Smallest set at least as large as the scale, else the largest.
  local.best = -1;
  for (local.i = 0; i < SETS; i++)
    if (SET[i].s >= s - 0.000001 && (best < 0 || SET[i].s < SET[best].s)) best = i;
  if (best < 0) {
    best = 0;
    for (local.i = 1; i < SETS; i++) if (SET[i].s > SET[best].s) best = i;
  }
  global.S = SET[best];
  global.f = s / S.s;
  global.cx = Window.GetX() + Math.Int(CW / 2);
  global.cy = Window.GetY() + Math.Int(CH / 2);

  // Arcs of the dotted rings (they come ring by ring), only those on the canvas.
  for (local.j = 0; j < RING_COUNT; j++) {
    global.ring_count[j] = 0;
    global.ring_first[j] = 0;
    global.ring_last[j] = -1;             // force the next update
  }
  local.n = 0;
  for (local.i = 0; i < S.tile_count; i++) {
    local.t = S.tile[i];
    local.x = cx + round(t.x * f);
    local.y = cy + round(t.y * f);
    if (x < cx + CW / 2 && y < cy + CH / 2 && x + t.w * f + 1 > cx - CW / 2 && y + t.h * f + 1 > cy - CH / 2) {
      if (ring_count[t.ring] == 0) global.ring_first[t.ring] = n;
      global.ring_count[t.ring]++;
      global.arc[n].sprite = Sprite(load(t.file));
      global.arc[n].x = x;
      global.arc[n].y = y;
      global.arc[n].mx = t.mx * f;
      global.arc[n].my = t.my * f;
      arc[n].sprite.SetPosition(x, y, 1);
      arc[n].sprite.SetOpacity(0);
      n++;
    }
  }
  global.ARCS = n;

  // Band: crust mask over the rings, mantle line, both as wide as the canvas.
  global.band.sprite = Sprite(Image("crust.png").Scale(CW, round(18 * s)));
  band.sprite.SetPosition(cx - Math.Int(CW / 2), cy - Math.Int(round(18 * s) / 2), 2);
  global.filet.sprite = Sprite(Image("mantle.png").Scale(CW, round(4 * s)));
  filet.sprite.SetPosition(cx - Math.Int(CW / 2), cy - Math.Int(round(4 * s) / 2), 3);
  filet.sprite.SetOpacity(0);

  // Half-rings: squares centred on the logo (rotation centre).
  for (local.i = 0; i < 4; i++) {
    global.half[i].image = load(S.half[i].file);
    global.half[i].side = S.half[i].side;
    global.half[i].sprite = Sprite(half[i].image);
    global.half[i].x = cx - Math.Int(half[i].image.GetWidth() / 2);
    global.half[i].y = cy - Math.Int(half[i].image.GetHeight() / 2);
    global.half[i].angle = 0;
    half[i].sprite.SetPosition(half[i].x, half[i].y, 4);
    half[i].sprite.SetOpacity(0);
  }

  // Lab name + KAUST emblem, top at 1090 (screen of 1200).
  global.lockup.sprite = Sprite(load("lockup.png"));
  lockup.sprite.SetPosition(round(cx - S.lockup.ew * f / 2 + S.lockup.dx * f),
                            round(cy + (1090 - 600) * s + S.lockup.dy * f), 3);
  lockup.sprite.SetOpacity(0);

  // Passphrase block, from cy + 184: prompt line, field, message line (layout measured on the reference).
  global.form.top = cy + 184 * s;
  global.form.field_y = form.top + S.form_field.y * f;
  global.form.field_cy = form.field_y + S.form_field.h * f / 2;
  global.form.img_idle = load("field-idle.png");
  global.form.img_active = load("field-active.png");
  global.form.img_error = load("field-error.png");
  global.form.img_wrong = load("msg-wrong.png");
  global.form.img_caps = load("msg-caps.png");
  global.form.field.sprite = Sprite(form.img_idle);
  form.field.sprite.SetPosition(round(cx - S.form_field.w * f / 2 + S.field_idle.dx * f),
                                round(form.field_y + S.field_idle.dy * f), 10);
  global.form.placeholder.sprite = Sprite(load("placeholder.png"));
  form.placeholder.sprite.SetPosition(round(cx - S.placeholder.ew * f / 2 + S.placeholder.dx * f),
                                      round(form.field_cy - S.placeholder.eh * f / 2 + S.placeholder.dy * f), 11);
  global.form.message.sprite = Sprite(form.img_wrong);
  global.form.message.y = form.top + S.form_msgline.y * f;
  global.form.dot_img = load("dot.png");
  for (local.k = 0; k < 22; k++) {
    global.dot[k].sprite = Sprite(form.dot_img);
    dot[k].sprite.SetOpacity(0);
  }
  global.form.prompt_text = "";          // redrawn (Image.Text) on the next update
  global.form.field_key = "idle";
  global.form.msg_key = "";              // position set on first use
  global.form.dirty = 1;
  global.SCENE = 1;
  form_hide_all();
}

fun form_hide_all() {
  form.prompt.sprite.SetOpacity(0);
  form.field.sprite.SetOpacity(0);
  form.placeholder.sprite.SetOpacity(0);
  form.message.sprite.SetOpacity(0);
  for (local.k = 0; k < 22; k++) dot[k].sprite.SetOpacity(0);
}

// --- Passphrase block ---------------------------------------------------------------------------------------------

pw.active = 0;           // a passphrase is asked and not yet accepted
pw.state = "idle";       // idle | typing | verify (field fading out, rotation) | error
pw.bullets = 0;
pw.prompt = "";
form.op = 0;             // block opacity (fades)
form.from = 0;
form.to = 0;
form.t0 = 0;
form.dur = 1;

fun form_fade(to, ms) {
  global.form.from = form.op;
  global.form.to = to;
  global.form.t0 = now;
  global.form.dur = ms;
}

fun set_prompt_image() {
  if (form.prompt_text == pw.prompt) return;
  global.form.prompt_text = pw.prompt;
  // subtext0, Inter (theme font, embedded by the hook), 16 px on a 1200 px screen
  local.img = Image.Text(pw.prompt, 166 / 255, 173 / 255, 200 / 255, 1, "Inter " + round(16 * s) + "px");
  global.form.prompt.sprite = Sprite(img);
  form.prompt.sprite.SetPosition(round(cx - img.GetWidth() / 2),
                                 round(form.top + (S.form_prompt.y + S.form_prompt.h / 2) * f - img.GetHeight() / 2), 10);
  form.prompt.sprite.SetOpacity(0);
}

// Applies the state to the sprites; o = block opacity, dots_o = pulse while verifying.
fun form_frame() {
  if (!SCENE) return;
  local.p = (now - form.t0) / form.dur;
  global.form.op = form.from + (form.to - form.from) * ease(EASE, p);
  local.o = form.op;
  if (o < 0.011 && form.to == 0) { if (form.shown) { form_hide_all(); global.form.shown = 0; } return; }
  global.form.shown = 1;
  local.verifying = (pw.state == "verify");    // the block fades out as it was entered
  set_prompt_image();
  form.prompt.sprite.SetOpacity(o);

  // Border: overlay0 at rest, green while typing / verifying, red after a refusal (until the next key).
  local.fk = "idle";
  if (pw.state == "error") fk = "error";
  else if (pw.bullets > 0 || verifying) fk = "active";
  if (fk != form.field_key) {
    if (fk == "error") form.field.sprite.SetImage(form.img_error);
    else if (fk == "active") form.field.sprite.SetImage(form.img_active);
    else form.field.sprite.SetImage(form.img_idle);
    global.form.field_key = fk;
  }
  form.field.sprite.SetOpacity(o);

  if (pw.bullets == 0 && !verifying) form.placeholder.sprite.SetOpacity(o);
  else form.placeholder.sprite.SetOpacity(0);

  // Dots: 10 px, 10 px apart, centred, 22 at most.
  local.n = Math.Min(pw.bullets, 22);
  local.x0 = cx - (n * 20 - 10) * s / 2;
  for (local.k = 0; k < 22; k++) {
    if (k < n) {
      dot[k].sprite.SetPosition(round(x0 + k * 20 * s + S.dot.dx * f), round(form.field_cy - 5 * s + S.dot.dy * f), 11);
      dot[k].sprite.SetOpacity(o);
    }
    else dot[k].sprite.SetOpacity(0);
  }

  // Message: Wrong passphrase > Caps Lock is on.
  local.key = "";
  if (pw.state == "error") key = "msg_wrong";
  else if (!verifying && Plymouth.GetCapslockState()) key = "msg_caps";
  if (key != "") {
    if (key != form.msg_key) {
      if (key == "msg_wrong") form.message.sprite.SetImage(form.img_wrong);
      else form.message.sprite.SetImage(form.img_caps);
      global.form.msg_key = key;
      form.message.sprite.SetPosition(round(cx - S[key].ew * f / 2 + S[key].dx * f), round(form.message.y + S[key].dy * f), 10);
    }
    form.message.sprite.SetOpacity(o);
  }
  else form.message.sprite.SetOpacity(0);
}

fun display_password(prompt, bullets) {
  // Asked again after Enter with the same prompt: refused. Another prompt (second volume): a new request.
  if (pw.state == "verify" && prompt == pw.prompt) global.pw.state = "error";
  else if (bullets > 0) global.pw.state = "typing";      // a key clears the refusal
  else if (pw.state != "error" || prompt != pw.prompt) global.pw.state = "idle";
  global.pw.prompt = prompt;
  global.pw.bullets = bullets;
  global.pw.active = 1;
  // Shown at once (after the intro); a rotation in progress stops at the end of its turn.
  if (phase != "intro" && form.to == 0) form_fade(1, 300);
}
Plymouth.SetDisplayPasswordFunction(display_password);

fun display_normal() {
  if (pw.active && pw.state != "verify" && pw.state != "error") {   // Enter: cryptsetup derives the key (seconds)
    global.pw.state = "verify";
    form_fade(0, 500);                     // the block leaves and the rotation runs during the check
    if (phase == "prompt") start_loop();
  }
}
Plymouth.SetDisplayNormalFunction(display_normal);

fun unlocked() {
  if (!pw.active) return;
  global.pw.active = 0;
  global.pw.state = "idle";
  global.pw.bullets = 0;
  if (form.to != 0) form_fade(0, 500);
  if (phase == "prompt") start_loop();     // the rotation goes on until the end of the boot
}
Plymouth.SetRootMountedFunction(unlocked);  // root mounted (hook update-root-fs): the volume is open

// --- Phases ---------------------------------------------------------------------------------------------------------

MODE = Plymouth.GetMode();
phase = "intro";
frame = 0;               // refreshes since the start
now = 0;                 // animation time (ms)
frame_ms = 1000 / REFRESH; // real frame period (ms), measured on the boot clock
phase_t0 = 0;            // animation time at the start of the phase
loop_cycle = -1;         // rotation cycle in progress
exit_requested = 0;

// Boot clock (seconds). A window of at least 0.5 s gives the frame period; a clock that stops moving (more than 6
// refreshes without a new value: paused) starts a new window, and the animation time is re-anchored when it moves again.
bc.clock = -1;
bc.offset = 0;           // animation time - clock (ms), set when the clock (re)starts
bc.cal_clock = -1;
bc.cal_frame = 0;
bc.last_clock = -1;
bc.last_frame = 0;
fun boot_progress(duration, progress) { global.bc.clock = duration; }

fun measure_frame() {
  if (bc.clock < 0 || bc.clock == bc.last_clock) return;
  if (bc.cal_clock < 0 || frame - bc.last_frame > 6) {
    global.bc.cal_clock = bc.clock;
    global.bc.cal_frame = frame;
    global.bc.offset = now - bc.clock * 1000;
  }
  else if (bc.clock - bc.cal_clock >= 0.5) {
    local.ms = 1000 * (bc.clock - bc.cal_clock) / (frame - bc.cal_frame);
    if (ms >= 8 && ms <= 60) global.frame_ms = ms;
    global.bc.cal_clock = bc.clock;
    global.bc.cal_frame = frame;
  }
  global.bc.last_clock = bc.clock;
  global.bc.last_frame = frame;
}

fun start_phase(name) {
  global.phase = name;
  global.phase_t0 = now;
  global.loop_cycle = -1;
}

fun start_loop() {
  start_phase("loop");
}

fun intro_frame(ms) {
  for (local.j = 0; j < RING_COUNT; j++) {
    local.p = (ms - 900 - j * 45) / 600;
    if (p < 0) p = 0;
    if (p > 1) p = 1;
    if (p != ring_last[j]) {               // only rings that move this frame
      global.ring_last[j] = p;
      local.op = ease(EASE_RING_IN, p);
      local.sc = 0.94 + 0.06 * op;
      for (local.k = ring_first[j]; k < ring_first[j] + ring_count[j]; k++) {
        arc[k].sprite.SetPosition(arc[k].x + round((sc - 1) * arc[k].mx), arc[k].y + round((sc - 1) * arc[k].my), 1);
        arc[k].sprite.SetOpacity(op);
      }
    }
  }
  for (local.i = 0; i < 4; i++) {
    local.p = ease(EASE_HALF_IN, (ms - i * 120) / 900);
    half[i].sprite.SetX(half[i].x + round(half[i].side * (1 - p) * 640 * s));
    half[i].sprite.SetOpacity(p);
  }
  filet.sprite.SetOpacity(ease(EASE, ms / 400));
  lockup.sprite.SetOpacity(ease(EASE, (ms - 400) / 600));
}

fun set_angle(i, angle) {
  if (angle == half[i].angle) return;
  if (angle == 0) half[i].sprite.SetImage(half[i].image);
  else half[i].sprite.SetImage(half[i].image.Rotate(angle));
  global.half[i].angle = angle;
}

// Half-ring i turns once (even: clockwise, odd: counter-clockwise) in the first half of each cycle, i × 150 ms late.
fun loop_frame(ms) {
  for (local.i = 0; i < 4; i++) {
    local.u = ms - i * 150;
    local.angle = 0;
    if (u > 0) {
      u = u - Math.Int(u / 2400) * 2400;
      if (u < 1200) angle = ease(EASE_SPIN, u / 1200) * 2 * Math.Pi * half[i].side;
    }
    set_angle(i, angle);
  }
}

fun exit_frame(ms) {
  for (local.i = 0; i < 4; i++) {
    local.p = ease(EASE_HALF_OUT, (ms - (3 - i) * 80) / 650);
    half[i].sprite.SetX(half[i].x + round(half[i].side * p * 640 * s));
    half[i].sprite.SetOpacity(1 - p);
  }
  for (local.j = 0; j < RING_COUNT; j++) {
    local.op = 1 - ease(EASE, (ms - (RING_COUNT - 1 - j) * 30) / 500);
    if (op != ring_last[j]) {
      global.ring_last[j] = op;
      for (local.k = ring_first[j]; k < ring_first[j] + ring_count[j]; k++) arc[k].sprite.SetOpacity(op);
    }
  }
  filet.sprite.SetOpacity(1 - ease(EASE, (ms - 300) / 500));
  lockup.sprite.SetOpacity(1 - ease(EASE, (ms - 350) / 500));
}

// Static frame of a phase, after a (re)build of the scene.
fun apply_phase() {
  if (phase == "intro") return;            // drawn by intro_frame
  local.op = 1;
  if (phase == "done") op = 0;
  for (local.k = 0; k < ARCS; k++) { arc[k].sprite.SetOpacity(op); }
  for (local.j = 0; j < RING_COUNT; j++) global.ring_last[j] = op;
  for (local.i = 0; i < 4; i++) { half[i].sprite.SetOpacity(op); global.half[i].angle = 0; }
  filet.sprite.SetOpacity(op);
  lockup.sprite.SetOpacity(op);
}

fun refresh() {
  if (!SCENE) return;
  global.frame++;
  measure_frame();
  local.next = now + frame_ms;
  if (bc.last_clock >= 0 && frame - bc.last_frame <= 6) {   // clock running: follow it, never ahead by more than 50 ms
    local.c = bc.clock * 1000 + bc.offset;
    if (next < c) next = c;
    if (next > c + 50) next = c + 50;
    if (next < now) next = now;
  }
  global.now = next;
  local.ms = now - phase_t0;

  if (phase == "intro") {
    intro_frame(ms);
    if (ms >= 2200) {
      if (pw.active && pw.state != "verify") { start_phase("prompt"); form_fade(1, 300); }
      else start_loop();                   // no passphrase, or entered blind during the intro
    }
  }
  else if (phase == "loop") {
    // Cycle boundary: every half-ring at rest. Exit, or hold while a passphrase is awaited (refused, or asked late).
    local.c = Math.Int(ms / CYCLE_MS);
    if (c != loop_cycle) {
      global.loop_cycle = c;
      if (exit_requested) { start_phase("exit"); for (local.i = 0; i < 4; i++) set_angle(i, 0); }
      else if (pw.active && pw.state != "verify") start_phase("prompt");
    }
    if (phase == "loop") loop_frame(ms);
  }
  else if (phase == "exit") {
    exit_frame(ms);
    if (ms >= 950) global.phase = "done";
  }
  else if (phase == "bench-intro") {
    intro_frame(ms);
    if (ms >= 2200) global.phase_t0 = now;
  }
  else if (phase == "bench-peak") {        // worst window: rings and half-rings both moving
    intro_frame(900 + ms - Math.Int(ms / 360) * 360);
  }
  else if (phase == "bench-loop") {
    loop_frame(ms);
  }
  form_frame();
}

fun update_status(text) {
  if (text == EXIT_STATUS) { global.exit_requested = 1; return; }
  if (text == "bench-intro" || text == "bench-peak" || text == "bench-loop" || text == "bench-idle") {
    start_phase(text);
    return;
  }
  // systemd reports units only after the switch to the real root: the volume is open.
  if (pw.active && pw.state == "verify") unlocked();
}

fun hotplug() {
  build_scene();
  apply_phase();
}

// Shutdown, reboot, updates: crust only. The plugin shows nothing without a sprite (background colour alone: text
// console left on screen), hence a crust sprite as large as the canvas.
fun blank_scene() {
  global.blank.sprite = Sprite(Image("crust.png").Scale(Window.GetWidth(), Window.GetHeight()));
  blank.sprite.SetPosition(Window.GetX(), Window.GetY(), 0);
}

if (MODE == "boot") {
  build_scene();
  Plymouth.SetRefreshRate(REFRESH);
  Plymouth.SetBootProgressFunction(boot_progress);
  Plymouth.SetRefreshFunction(refresh);
  Plymouth.SetUpdateStatusFunction(update_status);
  Plymouth.SetDisplayHotplugFunction(hotplug);
}
else {
  blank_scene();
  Plymouth.SetDisplayHotplugFunction(blank_scene);
}
