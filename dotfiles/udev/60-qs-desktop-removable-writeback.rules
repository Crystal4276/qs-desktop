# Disques USB et cartes SD : cache d'écriture borné à 16 Mio par périphérique (bdi, noyau 6.2+). Sinon, une copie vers une clé
# finit en mémoire (« terminé » dans Nemo) alors que l'écriture continue pendant des minutes ; comme KDE Frameworks 6.32
# (sync_file_range), la progression et la fin suivent alors l'écriture réelle. Installé par scripts/system-setup.sh.
ACTION=="add|change", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", ENV{ID_BUS}=="usb", ATTR{bdi/strict_limit}="1", ATTR{bdi/max_bytes}="16777216"
ACTION=="add|change", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", SUBSYSTEMS=="mmc", ATTRS{type}=="SD", ATTR{bdi/strict_limit}="1", ATTR{bdi/max_bytes}="16777216"
